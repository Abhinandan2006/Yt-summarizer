# ==========================================
# YT-RAG Configuration Settings
# ==========================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# LLM Providers Configuration
# Supported: "gemini", "openai"
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Key (Optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embeddings Configuration
# Options:
# - "sentence-transformers/all-MiniLM-L6-v2" (local, free, fast)
# - "text-embedding-3-small" (OpenAI)
# - "models/text-embedding-004" (Gemini)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Persistence Paths
VECTOR_STORE_PATH=./data/vector_store
CACHE_DB_PATH=./data/cache/yt_rag.db
TEMP_AUDIO_PATH=./data/temp_audio

# Ingestion & Chunking Parameters
CHUNK_DURATION_SEC=75
CHUNK_OVERLAP_SEC=15
MIN_CHUNK_CHARACTERS=80

# Speech-to-Text Fallback (Whisper)
# Size options: "tiny", "base", "small", "medium"
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

